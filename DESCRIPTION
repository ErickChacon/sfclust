Package: sfclust
Title: Bayesian Spatial Functional Clustering
Version: 1.1.0
Authors@R: c(
    person(c("Erick", "A."), "Chacón-Montalván", ,"erick.chaconmontalvan@wur.nl", role = c("aut", "cre"),
